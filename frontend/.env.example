# ── 백엔드 API base URL ────────────────────────────────────────────
# 로컬:       http://localhost:3000/api
# 프로덕션:   https://loci-api.onrender.com/api  (Render 백엔드 URL 로 교체)
VITE_API_URL=http://localhost:3000/api

# ── Google Maps / Places API 키 ────────────────────────────────────
# Google Cloud Console 에서 HTTP referrer 제한을 걸어두세요:
#   로컬: localhost:5173/*, localhost:8080/*
#   프로덕션: 배포된 Vercel 도메인 (예: loci.vercel.app/*)
VITE_GOOGLE_PLACES_API_KEY=
