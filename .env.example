# ──────────────────────────────────────────────────────────────────────
# Loci 환경변수
#   - 로컬 개발용: 이 파일을 .env 로 복사 후 값 채움
#   - 프로덕션 배포 (Render 등): 플랫폼의 환경변수 UI 에 같은 키로 입력
# ──────────────────────────────────────────────────────────────────────

# ── 데이터베이스 ─────────────────────────────────────────────────────
# 로컬 / 프로덕션 모두 Neon (serverless Postgres) 사용.
# 로컬 개발용은 Neon 의 dev branch DB 를 생성해 그 URL 을 쓰는 걸 권장
# (production DB 를 직접 건드리지 않으려는 안전장치).
#   형식: postgresql://USER:PASS@ep-XXX.neon.tech/DB?sslmode=require
DATABASE_URL=

# ── 외부 API ────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── 백엔드 포트 (로컬 dev — 프로덕션에선 플랫폼이 PORT 주입) ──────────
BACKEND_PORT=3000

# ── AWS S3 (이미지 업로드) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ── JWT ─────────────────────────────────────────────────────────────
# openssl rand -hex 64 로 생성한 충분히 긴 랜덤값 사용. 프로덕션 키는 로컬과 분리.
JWT_SECRET=

# ── CORS 화이트리스트 (쉼표 구분) ────────────────────────────────────
# 로컬:       http://localhost:5173
# 프로덕션:   https://loci.vercel.app  (Vercel 도메인으로 교체)
ALLOWED_ORIGINS=http://localhost:5173

# ── 프론트엔드 base URL — forgot-password 이메일 링크 생성용 ──────────
# 로컬:       http://localhost:5173
# 프로덕션:   https://loci.vercel.app
FRONTEND_URL=http://localhost:5173

# ── 운영 환경 플래그 ──────────────────────────────────────────────────
# 'production' 이면 cookie 가 sameSite='none' + secure=true 로 전환 (cross-origin 대응)
# Render 같은 PaaS 는 보통 자동으로 NODE_ENV=production 주입함
# NODE_ENV=production
